<?xml version="1.0" ?>
<robot name="humanoid_clean">

  <mujoco>
     <compiler meshdir="../bones/" balanceinertia="true" discardvisual="false" fusestatic="true"/>
  </mujoco>

  <link name="ground_link">
      <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="0.001" />
          <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
      </inertial>
  </link>

  <joint name="root_trans_x" type="prismatic">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="ground_link"/>
      <child link="root_trans_x_link"/>
      <axis xyz="1 0 0"/>
      <limit effort="1000" velocity="1.3963" lower="-100" upper="100"/>
  </joint>
  <link name="root_trans_x_link">
      <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="0.001" />
          <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
      </inertial>
  </link>

  <joint name="root_trans_y" type="prismatic">
      <origin rpy="0 0 0" xyz="0 0 0"/>
